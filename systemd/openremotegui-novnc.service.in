[Unit]
Description=OpenRemoteGUI browser VNC gateway (noVNC + websockify)
Documentation=https://github.com/@OWNER@/OpenRemoteGUI
After=default.target

[Service]
Type=simple
Environment=ORGUI_ETC=@ETC@
ExecStart=@PREFIX@/scripts/novnc-start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
